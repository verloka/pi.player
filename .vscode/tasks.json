{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "PiPlayer: prepare Windows debug",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/prepare-dev.ps1", "-DataPath", "${workspaceFolder}/artifacts/dev-data", "-SkipFrontend"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": "$msCompile",
      "presentation": { "reveal": "always", "panel": "dedicated" }
    }
  ]
}
